# HomeController - Portal Dokumentasi Resmi Larapak

gawe index(req, res)
    balekna baca_bab("changelog", res)
rampung

gawe unduh(req, res)
    judule = "Pusat Unduhan Resmi LarapakGo"
    subjudul = "Unduh Windows Setup Installer (.exe), berkas biner mandiri portable, dan ekstensi resmi LarapakGo."
    konteks = [
        "title": judule,
        "description": subjudul,
        "subjudul": subjudul,
        "badge": "November 2026 / v1.0.0 (Go Edition)",
        "current_url": "/unduh"
    ]
    balekna res.view("unduh.nview", konteks)
rampung

gawe unduh_item(req, res)
    item = req.params["item"]
    
    nek item == "setup" utawa item == "installer" utawa item == "LarapakGo-Setup-v1.0.0.exe" ya
        balekna res.redirect("https://github.com/IlhamHattaManggala/LarapakGo/raw/main/dist/LarapakGo-Setup-v1.0.0.exe")
    rampung

    nek item == "windows" utawa item == "larapak.exe" utawa item == "larapak-v1.0.0-windows-amd64.exe" ya
        balekna res.redirect("https://github.com/IlhamHattaManggala/LarapakGo/raw/main/dist/larapak-v1.0.0-windows-amd64.exe")
    rampung

    nek item == "linux" utawa item == "larapak-v1.0.0-linux-amd64" ya
        balekna res.redirect("https://github.com/IlhamHattaManggala/LarapakGo/raw/main/dist/larapak-v1.0.0-linux-amd64")
    rampung

    nek item == "macos" utawa item == "darwin" utawa item == "larapak-v1.0.0-darwin-arm64" ya
        balekna res.redirect("https://github.com/IlhamHattaManggala/LarapakGo/raw/main/dist/larapak-v1.0.0-darwin-arm64")
    rampung

    nek item == "vscode" utawa item == "vsix" utawa item == "larapak-vscode-1.0.0.vsix" ya
        balekna res.redirect("https://github.com/IlhamHattaManggala/LarapakGo/raw/main/dist/larapak-vscode-1.0.0.vsix")
    rampung

    balekna res.redirect("/unduh")
rampung

gawe bab(req, res)
    slug = req.params["slug"]
    balekna baca_bab(slug, res)
rampung

gawe baca_bab(slug, res)
    judule = "Catatan Rilis (Changelog)"
    subjudul = "Pembaruan dan rilis fitur terbaru pada ekosistem Larapak."
    
    nek slug == "instalasi" ya
        judule = "Instalasi & Memulai Cepat"
        subjudul = "Panduan memasang LarapakGo melalui installer resmi Windows (.exe), script biner Unix, atau Docker."
    rampung

    nek slug == "struktur" ya
        judule = "Struktur Direktori Proyek"
        subjudul = "Memahami fungsi folder dialek Ngapak: jeroan, dalan, lumbung, sawangan, dan njobo."
    rampung

    nek slug == "konfigurasi" ya
        judule = "Konfigurasi Lingkungan (.env)"
        subjudul = "Pengaturan variabel aplikasi, mode debug, zona waktu, dan koneksi database."
    rampung

    nek slug == "sintaksis" ya
        judule = "Sintaksis Bahasa NgapakIn"
        subjudul = "Panduan sintaksis dasar: variabel, fungsi gawe, nek-ya, dan perulangan baleni."
    rampung

    nek slug == "routing" ya
        judule = "Routing & Penanganan URL"
        subjudul = "Mengatur rute HTTP dinamis, response caching, API resource transformer, dan pendaftaran rute."
    rampung

    nek slug == "controller" ya
        judule = "Controller & Penanganan Request"
        subjudul = "Membuat controller aksi, membaca parameter HTTP, dan menghasilkan response."
    rampung

    nek slug == "middleware" ya
        judule = "Middleware & Proteksi CSRF"
        subjudul = "Pencegat request HTTP, validasi token keamanan CSRF, dan pembatasan laju (throttling)."
    rampung

    nek slug == "template" ya
        judule = "Sistem Template Sawangan (.nview)"
        subjudul = "Pewarisan layout, section, direktif lokalisasi multi-bahasa, dan komponen RikatLive."
    rampung

    nek slug == "validasi" ya
        judule = "Validasi Formulir & Pesan Galat"
        subjudul = "Mesin validasi deklaratif di controller, aturan standar, direktif @error, dan flashing old input."
    rampung

    nek slug == "otentikasi" ya
        judule = "Otentikasi, Sandi PBKDF2 & Sesi"
        subjudul = "Scaffolding larapak gawe:auth, password hasher RFC 2898, cookie sesi HMAC-SHA256, dan pesan kilat."
    rampung

    nek slug == "migrasi" ya
        judule = "Migrasi Skema Database"
        subjudul = "Manajemen versi skema database, rollback, status migrasi, dan multi-database driver."
    rampung

    nek slug == "database" ya
        judule = "Database, Model ORM & Soft Deletes"
        subjudul = "Fluent Query Builder, Soft Deletes, model relasi, model factory, dan SQL Profiler."
    rampung

    nek slug == "antrian" ya
        judule = "Antrian Latar Belakang, Redis & Event"
        subjudul = "Queue workers non-blocking, klien Redis murni Go (RESP), dan sistem event listener kedadeyan."
    rampung

    nek slug == "storage" ya
        judule = "Penyimpanan Berkas, Upload & Mailer"
        subjudul = "Penanganan multipart upload berkas, disk storage, helper asset, dan pengiriman email SMTP."
    rampung

    nek slug == "rikat-css" ya
        judule = "Frontend Rikat CSS Engine"
        subjudul = "Framework CSS utility-first JIT berkinerja tinggi tanpa ketergantungan Node.js/npm."
    rampung

    nek slug == "rikat-ui" ya
        judule = "Frontend Rikat UI Komponen"
        subjudul = "Mesin web components reaktif dengan two-way data binding dan komponen enterprise."
    rampung

    nek slug == "studio" ya
        judule = "Route Studio, DB Inspector & Profiler"
        subjudul = "Lingkungan pengembang visual terintegrasi: inspektur database, penanda slow query, dan OpenAPI export."
    rampung

    nek slug == "docker" ya
        judule = "Deployment & Docker Container"
        subjudul = "Menjalankan aplikasi LarapakGo di VPS produksi menggunakan Docker Compose dan biner mandiri native."
    rampung

    nek slug == "cli" ya
        judule = "Referensi Perintah LarapakGo CLI"
        subjudul = "Daftar lengkap perintah baris perintah larapak untuk mempercepat pengembangan."
    rampung

    view_path = "dok/" + slug
    cur_url = "/dok/" + slug
    nek slug == "changelog" ya
        cur_url = "/"
    rampung
    konteks = ["title": judule, "slug": slug, "badge": "November 2026 / v1.0.0 (Go Edition)", "subjudul": subjudul, "description": subjudul, "current_url": cur_url]
    balekna res.view(view_path, konteks)
rampung

gawe komponen_semua(req, res)
    balekna baca_komponen("semua", res)
rampung

gawe komponen_detail(req, res)
    slug = req.params["slug"]
    balekna baca_komponen(slug, res)
rampung

gawe baca_komponen(slug, res)
    judule = "Katalog Komponen UI (UI Kit)"
    subjudul = "Pustaka 34 kategori komponen antarmuka modern siap pakai berbasis Rikat CSS dan Rikat UI."
    
    nek slug == "tombol" ya
        judule = "Komponen Tombol (Buttons)"
        subjudul = "Varian tombol aksi utama, sekunder, outline, bahaya, ghost, ikon, dan status loading."
    rampung
    nek slug == "input" ya
        judule = "Komponen Formulir & Input"
        subjudul = "Elemen input teks, pencarian berikon, input password, floating label, dan textarea."
    rampung
    nek slug == "dropdown" ya
        judule = "Komponen Dropdown & Pilihan"
        subjudul = "Menu dropdown melayang dengan item ikon, divider, dan select kustom."
    rampung
    nek slug == "pilihan" ya
        judule = "Komponen Checkbox, Radio & Switch"
        subjudul = "Elemen pemilih modern: checkbox kustom, grup radio button, dan toggle switch."
    rampung
    nek slug == "kartu" ya
        judule = "Komponen Kartu & Panel"
        subjudul = "Container kartu metrik KPI, profil pengguna, dan kartu konten terstruktur."
    rampung
    nek slug == "badge" ya
        judule = "Komponen Badge & Status"
        subjudul = "Penanda status ringkas dengan indikator dot aktif, pil warna, dan counter notifikasi."
    rampung
    nek slug == "alert" ya
        judule = "Komponen Alert & Notifikasi"
        subjudul = "Kotak pesan umpan balik sukses, perhatian, peringatan bahaya, dan floating banner."
    rampung
    nek slug == "modal" ya
        judule = "Komponen Modal & Dialog"
        subjudul = "Jendela dialog pop-up interaktif, konfirmasi aksi, dan web component Rikat UI."
    rampung
    nek slug == "tabel" ya
        judule = "Komponen Tabel Data"
        subjudul = "Tampilan data tabular bersih dengan sorting kolom, baris zebra, dan tombol aksi."
    rampung
    nek slug == "navigasi" ya
        judule = "Komponen Navigasi, Tab & Breadcrumb"
        subjudul = "Tab switcher, jejak navigasi breadcrumb, dan pagination halaman terstruktur."
    rampung
    nek slug == "avatar" ya
        judule = "Komponen Avatar & Pengguna"
        subjudul = "Foto profil pengguna, inisial nama, indikator online/offline, dan avatar group bertumpuk."
    rampung
    nek slug == "akordeon" ya
        judule = "Komponen Akordeon & FAQ"
        subjudul = "Panel lipat interaktif untuk daftar pertanyaan umum dan konten ekspansif."
    rampung
    nek slug == "progress" ya
        judule = "Komponen Progres, Spinner & Skeleton"
        subjudul = "Bilah progres persentase, stepper multi-langkah, spinner putar, dan skeleton loader."
    rampung
    nek slug == "tooltip" ya
        judule = "Komponen Tooltip & Popover"
        subjudul = "Petunjuk mengambang saat hover kursor mouse ke elemen atau ikon antarmuka."
    rampung
    nek slug == "statistik" ya
        judule = "Komponen Statistik & Metrik (KPI)"
        subjudul = "Panel dasbor metrik bisnis dengan indikator tren naik/turun dan kartu performa."
    rampung
    nek slug == "ikon" ya
        judule = "Koleksi Ikon Web Component (<l-icon>)"
        subjudul = "60+ ikon SVG modern Feather/Lucide siap pakai cukup dengan tag kustom <l-icon name='...' size='16'></l-icon>."
    rampung
    nek slug == "breadcrumb" ya
        judule = "Komponen Breadcrumb Navigasi"
        subjudul = "Penunjuk posisi halaman dalam hierarki situs dengan separator dan ikon kontekstual."
    rampung
    nek slug == "pagination" ya
        judule = "Komponen Paginasi Data"
        subjudul = "Kontrol pembagian data multi-halaman dengan tombol lompat, status aktif, dan rentang item."
    rampung
    nek slug == "toast" ya
        judule = "Komponen Toast & Notifikasi Pop-up"
        subjudul = "Notifikasi mengambang reaktif instan di pojok layar dengan dismiss otomatis."
    rampung
    nek slug == "drawer" ya
        judule = "Komponen Drawer & Offcanvas Panel"
        subjudul = "Panel navigasi atau detail samping yang meluncur masuk (slide-over) dari tepi layar."
    rampung
    nek slug == "unggah" ya
        judule = "Komponen Upload Berkas (Drag & Drop)"
        subjudul = "Area unggah berkas interaktif dengan drag-and-drop, daftar file, dan status upload."
    rampung
    nek slug == "stepper" ya
        judule = "Komponen Stepper Alur Multi-Langkah"
        subjudul = "Indikator progres form wizard bertahap untuk formulir panjang atau alur checkout."
    rampung
    nek slug == "timeline" ya
        judule = "Komponen Timeline Aktivitas"
        subjudul = "Urutan riwayat log aktivitas, jejak audit, dan timeline kejadian waktu kronologis."
    rampung
    nek slug == "empty-state" ya
        judule = "Komponen Tampilan Data Kosong (Zero State)"
        subjudul = "Placeholder ilustratif dan tombol panggilan aksi ramah pengguna saat data belum tersedia."
    rampung
    nek slug == "slider" ya
        judule = "Komponen Slider Rentang Nilai"
        subjudul = "Kontrol geser interaktif untuk pemilihan angka, rentang nilai, step interval, dan binding reaktif."
    rampung
    nek slug == "rating" ya
        judule = "Komponen Rating Bintang Interaktif"
        subjudul = "Penilaian bintang interaktif dengan hover visual, mode baca-saja, dan dukungan ikon fleksibel."
    rampung
    nek slug == "segmented" ya
        judule = "Komponen Segmented Control"
        subjudul = "Pilihan opsi eksklusif horizontal ala tombol pil untuk filter tampilan, periode waktu, atau tema."
    rampung
    nek slug == "divider" ya
        judule = "Komponen Divider Pemisah Konten"
        subjudul = "Garis pemisah visual horizontal dan vertikal dengan dukungan teks tengah, ikon, dan garis putus-putus."
    rampung
    nek slug == "chip" ya
        judule = "Komponen Chip & Tag Interaktif"
        subjudul = "Elemen tag kompak untuk kategori, filter pilihan, informasi pengguna, dan tombol hapus dismissible."
    rampung
    nek slug == "kbd" ya
        judule = "Komponen Kbd (Keyboard Shortcut)"
        subjudul = "Penanda tombol pintasan keyboard semantik untuk panduan pintas tombol di seluruh aplikasi."
    rampung
    nek slug == "otp" ya
        judule = "Komponen Input OTP / PIN Verifikasi"
        subjudul = "Bidang input kode verifikasi multi-digit dengan autofokus cerdas dan navigasi keyboard mulus."
    rampung
    nek slug == "color-picker" ya
        judule = "Komponen Pemilih Warna (Color Picker)"
        subjudul = "Pemilih palet warna swatches dan input warna heksadesimal dengan preview visual langsung."
    rampung
    nek slug == "tree" ya
        judule = "Komponen Tree (Struktur Berkas Hierarki)"
        subjudul = "Navigasi struktur folder dan data bertingkat (nested) dengan ekspansi lipat dan ikon berkas."
    rampung
    nek slug == "skeleton" ya
        judule = "Komponen Skeleton Loading (Placeholder Shimmer)"
        subjudul = "Kerangka efek shimmer untuk transisi pemuatan data yang anggun pada kartu, tabel, dan avatar."
    rampung

    view_path = "komponen/" + slug
    cur_url = "/komponen/" + slug
    nek slug == "semua" ya
        cur_url = "/komponen"
    rampung
    konteks = ["title": judule, "slug": slug, "badge": "UI Kit / Rikat", "subjudul": subjudul, "description": subjudul, "current_url": cur_url]
    balekna res.view(view_path, konteks)
rampung

gawe sitemap(req, res)
    base_url = "https://larapak.my.id"
    today = "2026-11-02"
    
    xml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n"
    xml = xml + "  <url>\n    <loc>" + base_url + "/</loc>\n    <lastmod>" + today + "</lastmod>\n    <changefreq>daily</changefreq>\n    <priority>1.0</priority>\n  </url>\n"
    xml = xml + "  <url>\n    <loc>" + base_url + "/unduh</loc>\n    <lastmod>" + today + "</lastmod>\n    <changefreq>daily</changefreq>\n    <priority>1.0</priority>\n  </url>\n"
    
    doks = ["changelog", "instalasi", "struktur", "konfigurasi", "sintaksis", "routing", "controller", "validasi", "middleware", "template", "otentikasi", "migrasi", "database", "antrian", "storage", "rikat-css", "rikat-ui", "studio", "docker", "cli"]
    baleni slug neng doks
        xml = xml + "  <url>\n    <loc>" + base_url + "/dok/" + slug + "</loc>\n    <lastmod>" + today + "</lastmod>\n    <changefreq>weekly</changefreq>\n    <priority>0.9</priority>\n  </url>\n"
    rampung
    
    xml = xml + "  <url>\n    <loc>" + base_url + "/komponen</loc>\n    <lastmod>" + today + "</lastmod>\n    <changefreq>weekly</changefreq>\n    <priority>0.8</priority>\n  </url>\n"
    
    kompons = ["tombol", "input", "dropdown", "pilihan", "kartu", "badge", "alert", "modal", "tabel", "navigasi", "avatar", "akordeon", "progress", "tooltip", "statistik", "ikon", "breadcrumb", "pagination", "toast", "drawer", "unggah", "stepper", "timeline", "empty-state", "slider", "rating", "segmented", "chip", "divider", "kbd", "color-picker", "otp", "tree", "skeleton"]
    baleni slug neng kompons
        xml = xml + "  <url>\n    <loc>" + base_url + "/komponen/" + slug + "</loc>\n    <lastmod>" + today + "</lastmod>\n    <changefreq>monthly</changefreq>\n    <priority>0.7</priority>\n  </url>\n"
    rampung
    
    xml = xml + "</urlset>"
    balekna res.xml(xml)
rampung

gawe robots(req, res)
    txt = "User-agent: *\nAllow: /\nDisallow: /api-studio\nDisallow: /api-studio/\nDisallow: /api/studio\nDisallow: /api/studio/\n\nSitemap: https://larapak.my.id/sitemap.xml\n"
    balekna res.text(txt)
rampung
