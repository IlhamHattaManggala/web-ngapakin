    </div>
    <div id="iconCopiedToast" style="display:none; position:fixed; bottom:2rem; right:2rem; background:#10b981; color:#ffffff; padding:0.6rem 1.25rem; border-radius:8px; font-weight:600; font-size:0.85rem; box-shadow:0 8px 24px rgba(0,0,0,0.5); z-index:9999;">
        Tag ikon tersalin ke clipboard!
    </div>
    <script>
        const input = document.getElementById('iconFilterInput');
        const grid = document.getElementById('iconGridContainer');
        const toast = document.getElementById('iconCopiedToast');
        if (input && grid) {
            input.addEventListener('input', (e) => {
                const q = ((e.detail && e.detail.value !== undefined) ? e.detail.value : (e.target.value || '')).toLowerCase().trim();
                const cards = grid.querySelectorAll('.icon-card');
                let count = 0;
                cards.forEach(c => {
                    const name = c.getAttribute('data-icon');
                    if (!q || name.includes(q)) {
                        c.style.display = 'flex';
                        count++;
                    } else {
                        c.style.display = 'none';
                    }
                });
                const countEl = document.getElementById('iconTotalCount');
                if (countEl) countEl.innerText = count;
            });
        }
        if (grid) {
            grid.addEventListener('click', (e) => {
                const card = e.target.closest('.icon-card');
                if (!card) return;
                const name = card.getAttribute('data-icon');
                const tag = `<l-icon name="${name}" size="16"></l-icon>`;
                navigator.clipboard.writeText(tag).then(() => {
                    if (toast) {
                        toast.style.display = 'block';
                        toast.innerText = `Tersalin: ${tag}`;
                        setTimeout(() => { toast.style.display = 'none'; }, 2000);
                    }
                });
            });
        }
    </script>
</div>
    </div>
    <pre class="component-code-block"><code>&lt;!-- Cara Menggunakan Web Component Ikon Rikat --&gt;
&lt;!-- 1. Ikon Standar (Ukuran default 16px) --&gt;
&lt;l-icon name="search"&gt;&lt;/l-icon&gt;
&lt;l-icon name="user"&gt;&lt;/l-icon&gt;
&lt;l-icon name="trash"&gt;&lt;/l-icon&gt;
&lt;l-icon name="bell"&gt;&lt;/l-icon&gt;

&lt;!-- 2. Kustomisasi Ukuran &amp; Warna --&gt;
&lt;l-icon name="star" size="20" color="#f59e0b"&gt;&lt;/l-icon&gt;
&lt;l-icon name="heart" size="24" color="#ef4444"&gt;&lt;/l-icon&gt;
&lt;l-icon name="shield" size="20" color="#10b981"&gt;&lt;/l-icon&gt;

&lt;!-- 3. Di Dalam Tombol &amp; Input --&gt;
&lt;button class="c-btn c-btn-primary"&gt;
    &lt;l-icon name="download" size="15"&gt;&lt;/l-icon&gt;
    &lt;span&gt;Unduh Berkas&lt;/span&gt;
&lt;/button&gt;</code></pre>
