            <!-- TAB 4: VS CODE -->
            <l-tab-panel header="VS Code">
                <div class="platform-tab-content">
                    <p class="platform-desc-lead">Ekstensi resmi Visual Studio Code untuk pewarnaan sintaksis TextMate, auto-completion template <code>.nview</code>, dan tema berkas resmi.</p>

